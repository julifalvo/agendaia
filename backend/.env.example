# Supabase -> Project Settings -> Database -> Connection string (URI)
# Usar el puerto 5432 (conexión directa) o 6543 (pooler). Cambiar el driver a asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<ref>.supabase.co
# Service role: bypassea RLS. Nunca exponer al frontend.
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

NOTIFICATIONS_WEBHOOK_URL=

# Mercado Pago -> mercadopago.com.ar/developers/panel -> Credenciales de producción
# (o de prueba mientras se testea). Access token, no el public key.
MERCADOPAGO_ACCESS_TOKEN=
BOOKING_DEPOSIT_AMOUNT=8500
# Dominio público del frontend (back_urls de Mercado Pago) y de este backend
# (notification_url del webhook). Ninguno puede ser localhost en producción.
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# Resend -> resend.com/api-keys. Manda el mail de confirmación con el turno
# adjunto (.ics) cuando el invitado deja su email, y el aviso de nuevo turno
# a la profesional asignada. Vacío = no se manda nada.
RESEND_API_KEY=
# "onboarding@resend.dev" anda sin verificar dominio propio (para arrancar),
# pero en sandbox Resend solo entrega al mail con el que se creó la cuenta.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Calendar -> console.cloud.google.com -> crear proyecto, habilitar
# "Google Calendar API", crear credenciales OAuth 2.0 (tipo "Web application")
# con este mismo GOOGLE_REDIRECT_URI en "Authorized redirect URIs". Una sola
# cuenta de Google por salón (no una por profesional). Vacío = deshabilitado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/admin/google-calendar/callback
# Clave para cifrar el refresh_token antes de guardarlo. Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_TOKEN_KEY=

DB_ECHO=false
CORS_ORIGINS=["http://localhost:5173"]
